# editorconfig.org — authoritative for the whole repo.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_size = 4

[*.{js,ts,mts,cts,vue,json,jsonc,css,scss,html}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 4

[{compose.yaml,compose.*.yaml,.github/**/*.yml,.github/**/*.yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.neon]
indent_size = 4
