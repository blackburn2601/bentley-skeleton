{% extends 'email/base.html.twig' %}
{% block subject %}Your password was changed{% endblock %}
{% block content %}
    <h1 style="font-size: 20px;">Your password was changed</h1>
    <p>The password on your account has just been changed, and every signed-in session was ended.</p>
    <p style="font-size: 13px; color: #666;">
        If this was not you, reset your password immediately and contact us — whoever made this
        change had access to your account or your mailbox.
    </p>
{% endblock %}
