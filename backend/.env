# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Dev-only value. `make new-project` regenerates this; prod reads it from a Docker secret.
APP_SECRET=e2ee87d28785ce37701244ac43c0d324
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://bentley:bentley@db:5432/bentley?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=${REDIS_URL}
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=9c04f7753ac68e7272a046d297d430fbc8f3e16e202e132040399b4b4582883f
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> bentley-skeleton ###
# Redis backs the rate limiter, the ACL cache and the lock store.
REDIS_URL=redis://redis:6379

# Token lifetimes (ADR-0002). Access tokens are deliberately short because permissions
# are resolved server-side and revocation must be near-immediate (ADR-0011).
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# Cookie scope. Cookies use the __Host- prefix, which REQUIRES Secure + Path=/ and
# forbids Domain — so there is no cookie domain setting here by design.
COOKIE_SAMESITE=strict

# Set to 0 to skip the Have I Been Pwned k-anonymity check (offline dev, CI).
PASSWORD_HIBP_CHECK=1

# Comma-separated trusted proxy CIDRs, or the literal REMOTE_ADDR. Rate limiting and
# audit logging record the wrong IP if this is not set correctly behind a load balancer.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS='^.*$'

# OpenTelemetry is compiled into the image but inert unless this is true (ADR-0017).
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=bentley-skeleton

# Where the SPA lives, for links in transactional emails.
FRONTEND_BASE_URL=http://localhost:5173

MAILER_FROM_ADDRESS=no-reply@bentley.localhost
MAILER_FROM_NAME="bentley-skeleton"

# Bearer-header auth for machine clients. Off by default — see services.yaml.
AUTH_ALLOW_BEARER_HEADER=0
###< bentley-skeleton ###
