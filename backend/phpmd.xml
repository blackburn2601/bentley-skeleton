<?xml version="1.0"?>
<ruleset name="bentley-skeleton"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>
        Size and complexity limits for the whole codebase. Controllers get much tighter
        limits from phpmd-api.xml — see that file for why.

        src/*/Domain is checked separately by phpmd-domain.xml: entities are wide but simple,
        and the count-based limits here are tuned for services.

        src/Maker is excluded on the command line: those classes implement MakerBundle's
        interface, so PHPMD reports every interface-mandated parameter the implementation does
        not happen to use, and it cannot know they are not ours to remove. They are dev-time
        generators, outside the layering contract and excluded from coverage for the same
        reason.
    </description>

    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties><property name="reportLevel" value="8"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity"/>
    <!--
        ExcessiveMethodLength counts LINES, including comments, and this codebase explains WHY
        rather than what — so a well-documented 20-statement method measures around 45 lines.
        The obvious fix would be NcssMethodCount, which counts non-commenting statements, but
        PHPMD 2.15 declares that rule without implementing it (its `class` is still PMD's Java
        one) and errors out if you reference it.

        So the threshold is raised instead, and the rules that are NOT fooled by comments —
        CyclomaticComplexity and NPathComplexity — are the ones kept tight. They are the better
        signal anyway: a long method full of explanation is fine, a branchy one is not.
    -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties><property name="minimum" value="70"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties><property name="minimum" value="400"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <!--
            10, because this counts CONSTRUCTOR parameters too, and constructor injection is
            how every collaborator arrives. A registration flow legitimately needs the user
            repository, the password policy, the breach check, the hasher, two other services,
            two facades, a clock and the entity manager — listing them is honest, and hiding
            them behind a bag object would make the dependencies invisible rather than fewer.
        -->
        <properties><property name="minimum" value="10"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties><property name="maxmethods" value="12"/></properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessivePublicCount">
        <properties><property name="minimum" value="12"/></properties>
    </rule>

    <rule ref="rulesets/design.xml/EvalExpression"/>
    <rule ref="rulesets/design.xml/ExitExpression"/>
    <rule ref="rulesets/design.xml/GotoStatement"/>
    <rule ref="rulesets/design.xml/NumberOfChildren"/>
    <rule ref="rulesets/design.xml/DepthOfInheritance">
        <properties><property name="minimum" value="3"/></properties>
    </rule>
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties><property name="maximum" value="15"/></properties>
    </rule>

    <!--
        UnusedFormalParameter is deliberately NOT enabled.

        This codebase implements a lot of framework interfaces — Doctrine Type, MakerBundle's
        AbstractMaker, event listeners — whose signatures are not ours to change. PHPMD reports
        every parameter such an implementation does not happen to use, and cannot tell that
        removing it would break the contract. The rule would therefore be satisfied only by an
        ever-growing suppression list, which is enforcement by attrition.
    -->
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateField"/>
    <rule ref="rulesets/unusedcode.xml/UnusedLocalVariable"/>
    <rule ref="rulesets/unusedcode.xml/UnusedPrivateMethod"/>

    <!--
        BooleanArgumentFlag is deliberately NOT enabled.

        Its target is a method whose boolean argument switches between two behaviours — a real
        single-responsibility smell. What it flags here is CONSTRUCTOR configuration:
        `$enabled` on the breach checker, `$allowBearerHeader` on the authenticator. Those come
        from environment variables, are read once, and switch nothing at the call site. The
        underlying concern is already covered better by INV-10: a service that does two things
        cannot describe itself in one sentence.
    -->
    <rule ref="rulesets/cleancode.xml/ErrorControlOperator"/>
    <!--
        StaticAccess is deliberately NOT enabled.

        The risk it targets — code reaching for global state — is already covered here by the
        layering rules and by ergebnis's noParameterWithContainerTypeDeclaration, which stops a
        service being handed the container. What PHPMD's rule actually flags in this codebase is
        named constructors on final readonly value objects (`ReadinessResponse::from()`,
        `HealthProbeResult::up()`), which are idiomatic and which our own maker templates
        generate. Its `exceptions` property takes an exact class list, so keeping it on would
        mean an ever-growing list edited by whoever hits it next — enforcement by attrition.
    -->

    <rule ref="rulesets/naming.xml/ConstantNamingConventions"/>
    <rule ref="rulesets/naming.xml/ConstructorWithNameAsEnclosingClass"/>
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <!-- 2, not 3: `up()`, `of()` and `is()` are perfectly clear as named constructors. -->
        <properties><property name="minimum" value="2"/></properties>
    </rule>
</ruleset>
