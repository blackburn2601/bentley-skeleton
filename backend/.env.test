# Test environment. Loaded after .env, so only the differences appear here.

KERNEL_CLASS='App\Kernel'
APP_SECRET='test-secret-not-used-for-anything-real'
APP_DEBUG=0

# Separate database. dama/doctrine-test-bundle wraps each test in a transaction and rolls it
# back, so tests do not see each other's writes — but the SCHEMA still has to exist, and
# sharing the development database would mean a test run could destroy work in progress.
#
# CI overrides this to 127.0.0.1; inside the compose network the host is "db".
# NOTE the database name is the BASE name, not bentley_test: doctrine.yaml appends
# a "_test" suffix under when@test (and a ParaTest token after it), so naming the
# test database here would produce bentley_test_test.
DATABASE_URL="postgresql://bentley:bentley@db:5432/bentley?serverVersion=18&charset=utf8"

# No outbound network in tests, ever. A suite that depends on a third party being reachable
# fails for reasons that have nothing to do with the code.
PASSWORD_HIBP_CHECK=0
MAILER_DSN=null://null

# Deterministic security posture for header and CSRF assertions.
SECURITY_HSTS_ENABLED=1
SECURITY_CSRF_ENABLED=1
RATE_LIMIT_ENABLED=0
AUTH_ALLOW_BEARER_HEADER=0

FRONTEND_BASE_URL=http://localhost:5173
MAILER_FROM_ADDRESS=no-reply@bentley.test
MAILER_FROM_NAME="bentley test"
HTTP_EGRESS_ALLOWLIST=
