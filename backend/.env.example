# This is the committed TEMPLATE, never the real environment file. It is not loaded by
# Symfony — .env.example is documentation of every variable the app expects, with the
# non-secret dev defaults filled in and the secret slots left empty.
#
# The real file is backend/.env, which is gitignored (see .gitignore) and generated per
# machine by `make env` / `bin/generate-env` from this template, with fresh secrets. It is
# never committed. Production does not run generate-env: it provisions the secrets as real
# environment variables or Docker secrets (see docs/OPERATIONS.md, ADR-0028).
#
# Symfony's own load order, for the generated .env and its overrides (later wins):
#   .env  →  .env.local  →  .env.$APP_ENV  →  .env.$APP_ENV.local  →  real env vars
#
# DO NOT DEFINE PRODUCTION SECRETS HERE NOR IN ANY OTHER COMMITTED FILE.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
# Empty in the template. `make env` / `bin/generate-env` fills a fresh per-machine value;
# prod provisions it from a Docker secret. Never run with this empty.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://bentley:bentley@db:5432/bentley?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=${REDIS_URL}
###< symfony/lock ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Empty in the template. `make env` / `bin/generate-env` fills a fresh per-machine value;
# the keypair itself is generated by `lexik:jwt:generate-keypair` into config/jwt/ (gitignored).
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> bentley-skeleton ###
# Redis backs the rate limiter, the ACL cache and the lock store.
REDIS_URL=redis://redis:6379

# Token lifetimes (ADR-0002). Access tokens are deliberately short because permissions
# are resolved server-side and revocation must be near-immediate (ADR-0011).
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# TOTP MFA (ADR-0026). The secret encrypting the user's TOTP key at rest (libsodium
# crypto_secretbox, 32 bytes base64). Empty in the template — `make env` / `bin/generate-env`
# fills a fresh per-machine value; prod provisions it from a Docker secret. SodiumSecretBox
# fails fast on an empty/short value, so the app refuses to boot until it is set.
TOTP_SECRET_KEY=
# How long the half-authenticated "challenge" JWT (ADR-0026) stays usable, in seconds.
# Short on purpose: an uncompleted challenge simply expires.
MFA_CHALLENGE_TTL=120

# Cookie scope. Cookies use the __Host- prefix, which REQUIRES Secure + Path=/ and
# forbids Domain — so there is no cookie domain setting here by design.
COOKIE_SAMESITE=strict

# Set to 0 to skip the Have I Been Pwned k-anonymity check (offline dev, CI).
PASSWORD_HIBP_CHECK=1

# Comma-separated trusted proxy CIDRs, or the literal REMOTE_ADDR. Rate limiting and
# audit logging record the wrong IP if this is not set correctly behind a load balancer.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HOSTS='^.*$'

# OpenTelemetry is compiled into the image but inert unless this is true (ADR-0017).
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SERVICE_NAME=bentley-skeleton

# Bearer-header auth for machine clients. Off by default — see services.yaml.
AUTH_ALLOW_BEARER_HEADER=0

# HSTS is off in development (no TLS on localhost) and must be ON in production.
SECURITY_HSTS_ENABLED=0
SECURITY_CSRF_ENABLED=1
RATE_LIMIT_ENABLED=1

# Comma-separated hostnames this application may call out to. EMPTY means no allow-list, and
# outbound requests are then permitted to any address that is not private, loopback or
# link-local. Set it in production: the allow-list is the real control, the address checks are
# the fallback for when it is deliberately open.
HTTP_EGRESS_ALLOWLIST=api.pwnedpasswords.com

# Field-level entity change history (ADR-0017). Separate from the security event log: that
# records WHAT HAPPENED, this records WHAT CHANGED.
#
# OFF by default because the hand-wired core library does not currently record on this stack —
# see ADR-0017 "Current status". The security event log is unaffected and fully working; this
# switch controls the secondary, field-level layer only. Turn it on once the gap is closed,
# and verify with a real flush before believing it.
AUDIT_ENTITY_HISTORY=0

# Who may scrape /metrics. Empty means nobody. In compose the scraper is on the bridge
# network; in production restrict this to the monitoring subnet.
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
###< bentley-skeleton ###
